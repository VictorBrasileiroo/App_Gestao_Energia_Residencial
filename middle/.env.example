# ========================================
# Middle Layer (API Gateway) Configuration
# ========================================

# Backend API URL (Internal Service)
BACKEND_URL=http://localhost:8000

# Gateway Port (External)
PORT=8001

# Security Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production-123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting Configuration
# Protects against DDoS and API abuse
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Caching Configuration
# Improves performance for frequent queries
ENABLE_CACHING=true
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/gateway.log

# CORS Configuration
# Add your frontend URLs here
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Timeout Configuration (seconds)
BACKEND_TIMEOUT=30
REQUEST_TIMEOUT=60
KEEP_ALIVE_TIMEOUT=5

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# Request Validation
MAX_REQUEST_SIZE=10485760  # 10MB
ENABLE_REQUEST_VALIDATION=true
SANITIZE_INPUTS=true

# Development/Production Mode
ENVIRONMENT=development
DEBUG=false
RELOAD=true

# Monitoring & Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Docker Configuration (for docker-compose)
# BACKEND_URL=http://backend:8000